// block67.app — Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Prisma Accelerate URL (prisma+postgres://)
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateCategory {
  TOKEN
  NFT
  DAO
  LANDING_PAGE
  DEFI
  OTHER
}

enum TemplateStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  SUCCESS
  FAILED
}

enum NetworkType {
  MAINNET
  TESTNET
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique           // null for wallet-only accounts
  walletAddress String?   @unique           // checksummed lowercase
  name          String?
  avatarUrl     String?
  password      String?                     // bcrypt hash — null for wallet-only
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  templates     Template[]

  @@map("block67_users")
}

// ─── AUTH NONCES (MetaMask SIWE challenge/response) ───────────────────────────

model AuthNonce {
  id        String   @id @default(cuid())
  address   String   @unique              // lowercase wallet address
  nonce     String
  expiresAt DateTime

  @@map("block67_auth_nonces")
}

// ─── CHAINS ───────────────────────────────────────────────────────────────────

model Chain {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  chainId        Int         @unique
  rpcUrl         String
  explorerUrl    String
  nativeCurrency String
  networkType    NetworkType @default(MAINNET)
  logoUrl        String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  deployments    Deployment[]

  @@map("block67_chains")
}

// ─── TEMPLATES ────────────────────────────────────────────────────────────────

model Template {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  category         TemplateCategory
  status           TemplateStatus   @default(PENDING_REVIEW)
  previewUrl       String?
  repoUrl          String?
  contractAbi      Json?
  contractBytecode String?
  parameters       Json             // TemplateParam[] JSON schema
  frontendConfig   Json?            // DashboardWidget[] config
  authorId         String
  isFeatured       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  author           User             @relation(fields: [authorId], references: [id])
  projects         Project[]

  @@map("block67_templates")
}

// ─── PROJECTS ─────────────────────────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique  // slug.block67.app
  description   String?
  status        ProjectStatus @default(DRAFT)
  ownerId       String
  templateId    String
  paramValues   Json
  customDomain  String?       @unique
  logoUrl       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner         User          @relation(fields: [ownerId], references: [id])
  template      Template      @relation(fields: [templateId], references: [id])
  deployments   Deployment[]
  domainConfig  DomainConfig?

  @@map("block67_projects")
}

// ─── DEPLOYMENTS ──────────────────────────────────────────────────────────────

model Deployment {
  id              String           @id @default(cuid())
  projectId       String
  chainId         String
  status          DeploymentStatus @default(PENDING)
  contractAddress String?
  txHash          String?
  deployerAddress String
  constructorArgs Json?
  gasUsed         String?
  errorMessage    String?
  deployedAt      DateTime?
  createdAt       DateTime         @default(now())

  project         Project          @relation(fields: [projectId], references: [id])
  chain           Chain            @relation(fields: [chainId], references: [id])

  @@map("block67_deployments")
}

// ─── DOMAIN CONFIG ────────────────────────────────────────────────────────────

model DomainConfig {
  id          String    @id @default(cuid())
  projectId   String    @unique
  domain      String    @unique
  verified    Boolean   @default(false)
  txtRecord   String
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?

  project     Project   @relation(fields: [projectId], references: [id])

  @@map("block67_domain_configs")
}
