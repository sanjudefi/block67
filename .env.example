# ─── DATABASE ────────────────────────────────────────────────────────────────
# Pooled URL — used by the app at runtime (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@ep-cool-name.region.aws.neon.tech/block67?sslmode=require"

# Direct (non-pooled) URL — used by Prisma for migrations
# On Neon: same host but with ?pgbouncer=true removed, or use the direct endpoint
DATABASE_ANY_CLIENT="postgresql://user:password@ep-cool-name-direct.region.aws.neon.tech/block67?sslmode=require"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── ADMIN BOOTSTRAP ──────────────────────────────────────────────────────────
# Used only once: POST /api/admin/setup to create the first admin account
# Pick any strong password — keep it secret
ADMIN_PASSWORD="choose-a-strong-admin-setup-key"

# ─── ANTHROPIC (Claude AI — for in-portal code generation) ───────────────────
# Get from: https://console.anthropic.com/settings/keys
ANT_KEY="sk-ant-..."

# ─── WALLET CONNECT ───────────────────────────────────────────────────────────
# Get from: https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=""

# ─── APP DOMAIN ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN="block67.app"

# ─── RPC ENDPOINTS ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_POLYGON_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY"
NEXT_PUBLIC_OP_RPC_URL="https://mainnet.optimism.io"
NEXT_PUBLIC_ARB_RPC_URL="https://arb1.arbitrum.io/rpc"
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# ─── VERCEL (for custom domain provisioning) ──────────────────────────────────
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
